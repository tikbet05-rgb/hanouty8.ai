import { NextResponse } from 'next/server';
import { supabaseAdmin } from '@/lib/supabase';

export async function POST(request: Request) {
  const body = await request.json();
  const email = String(body?.email || '').trim();
  const password = String(body?.password || '').trim();
  const fullName = String(body?.fullName || '').trim();

  if (!email || !password) {
    return NextResponse.json(
      { success: false, message: 'البريد الإلكتروني وكلمة المرور مطلوبان.' },
      { status: 400 }
    );
  }

  if (!supabaseAdmin) {
    return NextResponse.json(
      {
        success: false,
        message: 'لم يتم تكوين Supabase بعد. أضف SUPABASE_SERVICE_ROLE_KEY و NEXT_PUBLIC_SUPABASE_URL قبل إنشاء حساب فعلي.'
      },
      { status: 500 }
    );
  }

  try {
    const { data, error } = await supabaseAdmin.auth.signUp({
      email,
      password,
      options: {
        data: {
          full_name: fullName || email.split('@')[0]
        }
      }
    });

    if (error) {
      return NextResponse.json(
        { success: false, message: error.message || 'تعذر إنشاء الحساب.' },
        { status: 400 }
      );
    }

    const user = data.user;
    if (user) {
      await supabaseAdmin.from('profiles').upsert({
        id: user.id,
        email: user.email || email,
        full_name: fullName || user.user_metadata?.full_name || email.split('@')[0],
        plan: 'free',
        locale: 'ar'
      });
    }

    const response = NextResponse.json({
      success: true,
      message: 'تم إنشاء الحساب بنجاح. يرجى التحقق من البريد الإلكتروني إذا كان تأكيد الحساب مفعّلًا.',
      email,
      user: data.user,
      requiresConsent: true,
      timestamp: new Date().toISOString()
    });

    response.cookies.set('ribh_session', 'authenticated', {
      httpOnly: true,
      sameSite: 'lax',
      secure: process.env.NODE_ENV === 'production',
      path: '/',
      maxAge: 60 * 60 * 24 * 7
    });

    return response;
  } catch (error) {
    return NextResponse.json(
      { success: false, message: 'حدث خطأ أثناء إنشاء الحساب.' },
      { status: 500 }
    );
  }
}
